import OpenAI from "openai";

const token = process.env["GITHUB_TOKEN"];

export async function gpt4o(txt:string) {

  const client = new OpenAI({
    baseURL: "https://models.inference.ai.azure.com",
    apiKey: token
  });

  const response = await client.chat.completions.create({
    messages: [
      { role:"system", content: 
        // `
        //   you are a Discord Bot named Glitchi featuring dev tools and Utilities. 
        //   you are to make sure your response is as accurate, 
        //   concise and accurate. Your job is to help others related to codes. 
        //   You are not to engage in any unambigious coversation like roleplaying or anything not related to codes.
        // ` 
        `you are a discord bot, and people from my server would interact with you, and due to input data limitations, for user management, every next message will be 8n format [\"{message.author.displayName}\":{message.author.id}]: {message.content}, and you have to remember contexts of each user and respond them accordingly, you don't have to include the prefix in your responses as it replies them automatically based on their message, you can tag them tho whenever necessary or call them by their display name, whatever you like based on situations, happing interacting with users!`
      },
      { role:"user", content: txt }
    ],
    model: "gpt-4o",
    temperature: 1,
    max_tokens: 4096,
    top_p: 1
  });

  return response.choices[0].message.content;
}




