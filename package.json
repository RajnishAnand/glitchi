{
  "name": "discord-bot-glitchi",
  "version": "2.0.0",
  "description": "An open source Discord utility bot.",
  "main": "build/index.js",
  "imports": {
    "#libs": "./build/libs/index.js",
    "#api/@*": "./build/APIs/@*/index.js",
    "#api/*.js": "./build/APIs/*.js"
  },
  "scripts": {
    "clean-build": "rm ./build/ -r; npm run build",
    "build": "tsc -b",
    "start": "node build/index.js",
    "dev": "concurrently 'tsc -w' 'nodemon build'",

    "prepare-deploy":"npm run clean-build && cp package.json build/ && cp package-lock.json build/",
    "deploy": "npm run prepare-deploy && push-dir --dir=build --branch=production"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RajnishAnand/discord-bot-glitchi"
  },
  "keywords": [],
  "author": "Rajnish Anand",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "push-dir": "^0.4.1",
    "typescript": "^7.0.2"
  }
}
