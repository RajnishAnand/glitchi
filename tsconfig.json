{
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    // "moduleResolution": "node",
    "lib": ["es2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./build",
    "rootDir": "./src",
    "paths": {
      "client/*" : ["./src/client/*"],
      "#libs" : ["./src/libs/index"],
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
